# Copy to .env for local development. On the VPS this file lives outside the repo
# with 600 permissions and is mounted into the container as a secret.
#
# NEVER commit a real .env. NEVER put real keys in this example file.

NODE_ENV=development
PORT=3000
# Public origin, used for BTCPay redirect URLs and email links.
PUBLIC_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
DATABASE_URL=postgres://store:store@localhost:5432/store

# --- Encryption ---------------------------------------------------------
# Both are 32 raw bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ENCRYPTION_KEY encrypts customer PII at rest (AES-256-GCM).
# BLIND_INDEX_KEY derives the searchable HMAC for email lookups.
#
# WARNING: losing ENCRYPTION_KEY makes every existing order permanently
# unreadable. Changing BLIND_INDEX_KEY breaks guest order lookup and customer
# login until every row is re-indexed. Both are backed up with the database,
# separately from it, in the client's password manager.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Signs session cookies. Rotating this logs everybody out, which is harmless.
SESSION_SECRET=

# --- BTCPay Server ------------------------------------------------------
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
# Shared secret configured on the BTCPay webhook. Every incoming webhook is
# verified against this before it is allowed to change an order.
BTCPAY_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Store <orders@example.com>"

# --- Retention ----------------------------------------------------------
# Default only. The live value is set by the client in the admin and stored
# in the settings table; this is used to seed a fresh install.
DEFAULT_RETENTION_DAYS=30

# Public key the encrypted export is encrypted to. The client holds the
# matching private key offline. We must never hold it.
EXPORT_AGE_RECIPIENT=
