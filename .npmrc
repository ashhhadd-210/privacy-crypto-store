# No third-party code runs at install time. Zero packages in the lockfile need
# install scripts (verified 22 Sep), so this costs nothing today and blocks a
# future dependency from running arbitrary code on the developer machine on
# `npm install`. If a package genuinely needs a build step, add it explicitly
# with `npm rebuild <pkg>` and record why here.
ignore-scripts=true

# Reproducible installs only.
save-exact=true
