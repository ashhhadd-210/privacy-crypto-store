# Development happens on Windows, deployment is Linux. Without this, files
# checked out with CRLF break on the VPS: shell scripts fail with
# "bad interpreter: /bin/sh^M", and Dockerfile entrypoints fail the same way.
# Force LF for everything that the server executes or parses.

* text=auto eol=lf

*.sh      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.njk     text eol=lf
*.css     text eol=lf
*.js      text eol=lf
Dockerfile   text eol=lf
Caddyfile    text eol=lf
.env.example text eol=lf

# Binary, never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.age  binary
*.gpg  binary
