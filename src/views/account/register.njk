{% extends "layout.njk" %}
{% block content %}
<h1 class="page-title">Create an account</h1>
<div class="card account">
  <p class="muted">Optional. An account only keeps your order history in one place. It stores your
    email and a password, nothing else: your address is typed at each checkout and never kept on
    the account. You can delete it yourself at any time.</p>

  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}

  <form method="post" action="/account/register" autocomplete="on">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" maxlength="254" value="{{ email }}" autocomplete="email" required>
    <label for="password">Password <span class="muted-inline">(at least {{ minPassword }} characters)</span></label>
    <input id="password" name="password" type="password" minlength="{{ minPassword }}" maxlength="200" autocomplete="new-password" required>
    <button type="submit">Create account</button>
  </form>
  <p class="muted small-print">Already have one? <a href="/account/login">Sign in</a>.</p>
</div>
{% endblock %}
