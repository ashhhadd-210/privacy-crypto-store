{% extends "layout.njk" %}
{% block content %}

<nav class="crumbs"><a href="/">&larr; All products</a></nav>

<article class="detail">
  <div class="detail-media">
    <div class="detail-image{% if not product.inStock %} is-out{% endif %}">
      <img src="{{ product.image }}" alt="{{ product.imageAlt }}" width="800" height="800">
    </div>
    {% if gallery.length %}
    <ul class="gallery" aria-label="Product images">
      {% for g in gallery %}
      <li>
        <a href="{{ g.href }}"{% if g.current %} aria-current="true"{% endif %} aria-label="{{ g.label }}">
          <img src="{{ g.src }}" alt="" width="120" height="120" loading="lazy">
        </a>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>

  <div class="detail-body">
    <h1>{{ product.name }}</h1>
    <p class="price large">{{ product.price }}</p>

    {% if product.stockLabel %}
      <p class="stock{% if not product.inStock %} out{% endif %}">{{ product.stockLabel }}</p>
    {% endif %}

    {% for para in paragraphs %}<p>{{ para }}</p>{% endfor %}

    {% if product.inStock %}
      <form method="post" action="/cart/add">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="slug" value="{{ product.slug }}">
        <button type="submit">Add to cart</button>
      </form>
    {% else %}
      <p class="muted">This product is sold out.</p>
    {% endif %}
  </div>
</article>

{% endblock %}
