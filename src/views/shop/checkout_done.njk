{% extends "layout.njk" %}
{% block content %}

<h1 class="page-title">{{ title }}</h1>

<div class="card done">
  <p>Your order number is</p>
  <p class="order-number">{{ orderNumber }}</p>
  <p class="muted">Keep it. Together with your email, it is how you <a href="/order">check your order</a> later.</p>

  <p class="order-status">{{ status }}</p>
  <p>{{ detail }}</p>

  {% if payUnavailable %}
    <p class="notice warn" role="alert">The payment page could not be opened just now. Your order is saved; please try again in a moment.</p>
  {% endif %}
  {% if canPay %}
    <form method="post" action="/checkout/pay">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit">Pay {{ total }} in Bitcoin</button>
    </form>
  {% endif %}

  <ul class="summary-lines">
    {% for i in items %}
    <li><span>{{ i.name }} <span class="muted-inline">&times; {{ i.qty }}</span></span> <span>{{ i.total }}</span></li>
    {% endfor %}
  </ul>
  <p class="cart-row"><span>Subtotal</span> <span>{{ subtotal }}</span></p>
  {% if discount %}<p class="cart-row"><span>Discount</span> <span>&minus;{{ discount }}</span></p>{% endif %}
  <p class="cart-row"><span>Shipping</span> <span>{{ shipping }}</span></p>
  <p class="cart-subtotal cart-grand"><span>Total</span> <strong>{{ total }}</strong></p>
</div>

{% endblock %}
