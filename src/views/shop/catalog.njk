{% extends "layout.njk" %}
{% block content %}

<section class="hero">
  <div>
    <p class="eyebrow">Peptide accessories</p>
    <h1>Your routine, upgraded.<span class="glow">Your details, kept private.</span></h1>
    <p class="hero-sub">Reusable pens and supplies, paid for in Bitcoin. Check out without an account. Your name and address are encrypted when you order and erased once it is done.</p>
    <div class="hero-actions">
      <a class="button" href="#products">Shop now
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="button ghost" href="#questions">How it works</a>
    </div>
  </div>

  <aside class="flow" aria-label="What happens to every order">
    <div class="flow-head">
      <p class="flow-title">Every order, start to finish</p>
      <span class="flow-tag">Private</span>
    </div>
    <ol>
      <li>
        <span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
        <div><strong>Order placed</strong><span>Name, email and address encrypted at once</span></div>
      </li>
      <li>
        <span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 8h3.8a2 2 0 0 1 0 4H9.5h4.3a2 2 0 0 1 0 4H9.5zM11 6v2m0 8v2"/></svg></span>
        <div><strong>Paid in Bitcoin</strong><span>Straight to the store's own wallet. No card, no bank</span></div>
      </li>
      <li>
        <span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></span>
        <div><strong>Shipped</strong><span>Tracking number sent to your email</span></div>
      </li>
      <li>
        <span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></span>
        <div><strong>Details erased</strong><span>Automatically, on a fixed schedule</span></div>
      </li>
    </ol>
  </aside>
</section>

<ul class="perks" aria-label="Why shop here">
  <li>
    <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 8h3.8a2 2 0 0 1 0 4H9.5h4.3a2 2 0 0 1 0 4H9.5zM11 6v2m0 8v2"/></svg></span>
    <div><strong>Bitcoin only</strong><span>No card details to steal, no bank in the middle.</span></div>
  </li>
  <li>
    <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-3.5 4-5 7-5s6 1.5 7 5"/></svg></span>
    <div><strong>No account needed</strong><span>A name, an email and an address. Nothing more.</span></div>
  </li>
  <li>
    <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
    <div><strong>Encrypted, then erased</strong><span>Your details are locked on arrival and deleted on schedule.</span></div>
  </li>
  <li>
    <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z"/><circle cx="12" cy="12" r="2.5"/><path d="M4 4l16 16"/></svg></span>
    <div><strong>No tracking</strong><span>No analytics, no ads, nothing loaded from anyone else.</span></div>
  </li>
</ul>

<section class="section" id="products" aria-labelledby="products-title">
  <div class="section-head">
    <div>
      <h2 id="products-title">Shop</h2>
      <p>Reusable pens, cases and supplies.</p>
    </div>
    {% if products.length %}<span class="count">{{ products.length }} {{ 'product' if products.length == 1 else 'products' }}</span>{% endif %}
  </div>

  {% if products.length == 0 %}
    <div class="empty">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8"/></svg></div>
      <p class="empty-title">New products are on the way.</p>
      <p class="muted">Nothing is listed yet. Check back soon.</p>
    </div>
  {% else %}
  <ul class="grid">
    {% for p in products %}
    <li class="product">
      <a href="/p/{{ p.slug }}">
        <div class="thumb{% if not p.inStock %} is-out{% endif %}">
          <img src="{{ p.image }}" alt="{{ p.imageAlt }}" loading="lazy" width="800" height="800">
          {% if not p.inStock %}<span class="badge">Sold out</span>
          {% elif p.stockLabel and p.stockLabel != 'In stock' %}<span class="badge low">{{ p.stockLabel }}</span>{% endif %}
        </div>
        <div class="product-meta">
          <h2>{{ p.name }}</h2>
          <p class="price">{{ p.price }}</p>
          <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
      {% if p.stockLabel %}<p class="stock{% if not p.inStock %} out{% endif %}">{{ p.stockLabel }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>

<section class="section faq" id="questions" aria-labelledby="questions-title">
  <div class="section-head">
    <div>
      <h2 id="questions-title">Questions</h2>
      <p>How ordering works here, in plain words.</p>
    </div>
  </div>
  <div class="faq-list">
    <details>
      <summary>Do I need an account?</summary>
      <p>No. Check out as a guest with a name, an email and a delivery address. An account is optional and only keeps your order history in one place.</p>
    </details>
    <details>
      <summary>How do I pay with Bitcoin?</summary>
      <p>At checkout you are taken to a payment page with the amount and a QR code. Pay from any Bitcoin wallet. Your order is confirmed as soon as the payment arrives, and you get an email when it does.</p>
    </details>
    <details>
      <summary>What happens to my details?</summary>
      <p>Your name, email and address are encrypted the moment you order and are used only to ship it. A set time after your order is finished, they are erased for good. The full details are on the <a href="/privacy">privacy page</a>.</p>
    </details>
    <details>
      <summary>How do I track my order?</summary>
      <p>Use <a href="/order">Track order</a> with your order number and email. If you have an account, your orders are listed there too.</p>
    </details>
    <details>
      <summary>Where do you ship?</summary>
      <p>See <a href="/shipping-returns">shipping and returns</a> for regions, costs and how returns work.</p>
    </details>
  </div>
</section>

{% endblock %}
