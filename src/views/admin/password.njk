{% extends "layout.njk" %}
{% block content %}
{% include "admin/_nav.njk" %}

<h1>Change password</h1>
<div class="card-flat" style="max-width: 32rem">
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/admin/password" autocomplete="on">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="current">Current password</label>
    <input id="current" name="current" type="password" autocomplete="current-password" required>
    <label for="next">New password <span class="muted-inline">(at least 14 characters; a passphrase of four or five words is ideal)</span></label>
    <input id="next" name="next" type="password" autocomplete="new-password" minlength="14" required>
    <label for="confirm">New password again</label>
    <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="14" required>
    <button type="submit">Change password</button>
  </form>
  <p class="hint">Changing it signs out every other device signed in to the admin.</p>
</div>
{% endblock %}
