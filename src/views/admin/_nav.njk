<header class="admin-top">
  <div class="admin-top-in">
    <a class="admin-brand" href="/admin">
      <img src="/placeholder/logo.svg" alt="" width="128" height="32">
      <span class="admin-badge">Admin</span>
    </a>
    <div class="admin-tools">
      <a class="admin-tool" href="/" target="_blank" rel="noopener">View shop
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
      </a>
      {% if theme == 'dark' %}
      <a class="admin-tool icon" href="/theme/light?back={{ here | urlencode }}" aria-label="Switch to light mode" title="Light mode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </a>
      {% else %}
      <a class="admin-tool icon" href="/theme/dark?back={{ here | urlencode }}" aria-label="Switch to dark mode" title="Dark mode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </a>
      {% endif %}
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="admin-tool">Sign out</button>
      </form>
    </div>
  </div>
  <nav class="admin-nav" aria-label="Administration">
    <a href="/admin"{% if section == 'home' %} aria-current="page"{% endif %}>Overview</a>
    <a href="/admin/orders"{% if section == 'orders' %} aria-current="page"{% endif %}>Orders</a>
    <a href="/admin/products"{% if section == 'products' %} aria-current="page"{% endif %}>Products</a>
    <a href="/admin/promotions"{% if section == 'promotions' %} aria-current="page"{% endif %}>Discount codes</a>
    <a href="/admin/pages"{% if section == 'pages' %} aria-current="page"{% endif %}>Pages</a>
    <a href="/admin/export"{% if section == 'export' %} aria-current="page"{% endif %}>Export</a>
    <a href="/admin/settings"{% if section == 'settings' %} aria-current="page"{% endif %}>Settings</a>
  </nav>
</header>
