{% extends "layout.njk" %}
{% block content %}
{% include "admin/_nav.njk" %}

<h1>Settings</h1>

{% if saved %}<p class="notice" role="status">Saved.</p>{% endif %}
{% if purged is defined and purged != null %}<p class="notice" role="status">Purge finished: {{ purged }} order{% if purged != '1' %}s{% endif %} cleared of personal details.</p>{% endif %}
{% if hasErrors %}<p class="error" role="alert">Nothing was saved. Please fix the highlighted fields.</p>{% endif %}

<section class="card-flat narrow logo-card" id="logo">
  <h2>Logo</h2>
  {% if logoMessage %}<p class="{% if logoMessage.error %}error{% else %}notice{% endif %}" role="status">{{ logoMessage.text }}</p>{% endif %}
  <div class="logo-preview"><img src="{{ logoSrc | default('/placeholder/logo.svg') }}" alt="Current logo" width="160" height="40"></div>
  <form method="post" action="/admin/settings/logo" enctype="multipart/form-data" class="upload-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label for="f-logo">Upload a new logo</label>
    <input id="f-logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" required>
    <p class="hint">PNG, JPEG or WebP, up to 10 MB. A wide PNG with a transparent background works best, in a colour that reads on both light and dark backgrounds. Shown at the top and bottom of every page.</p>
    <button type="submit">Upload logo</button>
  </form>
  {% if hasLogo %}
  <form method="post" action="/admin/settings/logo/remove">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <button type="submit" class="link danger">Remove logo and use the placeholder</button>
  </form>
  {% endif %}
</section>

<form method="post" action="/admin/settings" class="admin-form" novalidate>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <fieldset>
    <legend>Store</legend>
    <div class="field{% if errors.store_name %} has-error{% endif %}">
      <label for="f-store_name">Store name</label>
      <input id="f-store_name" name="store_name" type="text" maxlength="60" value="{{ values.store_name }}" aria-describedby="h-store_name">
      {% if errors.store_name %}<p class="field-error" id="h-store_name">{{ errors.store_name }}</p>
      {% else %}<p class="hint" id="h-store_name">Shown in the browser tab and on every page.</p>{% endif %}
    </div>
    <div class="field-row">
      <div class="field">
        <label for="f-currency">Currency</label>
        <select id="f-currency" name="currency">
          {% for c in currencies %}<option value="{{ c }}"{% if values.currency == c %} selected{% endif %}>{{ c }}</option>{% endfor %}
        </select>
        <p class="hint">Prices are shown in this currency; customers pay the equivalent in Bitcoin.</p>
      </div>
      <div class="field{% if errors.shipping %} has-error{% endif %}">
        <label for="f-shipping">Flat shipping per order</label>
        <input id="f-shipping" name="shipping" type="text" inputmode="decimal" maxlength="12" value="{{ values.shipping }}" aria-describedby="h-shipping">
        {% if errors.shipping %}<p class="field-error" id="h-shipping">{{ errors.shipping }}</p>
        {% else %}<p class="hint" id="h-shipping">Added at checkout. 0 means free shipping.</p>{% endif %}
      </div>
    </div>
    <div class="field{% if errors.free_over %} has-error{% endif %}">
      <label for="f-free_over">Free shipping on orders over</label>
      <input id="f-free_over" name="free_over" type="text" inputmode="decimal" maxlength="12" value="{{ values.free_over }}" placeholder="No free shipping" aria-describedby="h-free_over">
      {% if errors.free_over %}<p class="field-error" id="h-free_over">{{ errors.free_over }}</p>
      {% else %}<p class="hint" id="h-free_over">When the items in an order, after bulk prices and any discounts, reach this amount, shipping is free. Leave empty to always charge shipping.</p>{% endif %}
    </div>
  </fieldset>

  <fieldset>
    <legend>Discounts by order total</legend>
    <p class="hint">Orders whose items reach an amount get a percentage off, worked out after any bulk prices. The highest one reached applies. Discount codes still work on top. Leave a row empty to switch it off.</p>
    {% if errors.spend %}<p class="field-error" role="alert">{{ errors.spend }}</p>{% endif %}
    {% for row in values.spend %}
    <div class="tier-row">
      <div class="field{% if errors.spend %} has-error{% endif %}">
        <label for="f-spend_over_{{ loop.index }}">Orders of at least</label>
        <input id="f-spend_over_{{ loop.index }}" name="spend_over_{{ loop.index }}" type="text" inputmode="decimal" maxlength="12" value="{{ row.over }}" placeholder="e.g. {{ [500, 1000, 2000][loop.index0] }}">
      </div>
      <div class="field{% if errors.spend %} has-error{% endif %}">
        <label for="f-spend_pct_{{ loop.index }}">Percent off</label>
        <input id="f-spend_pct_{{ loop.index }}" name="spend_pct_{{ loop.index }}" type="text" inputmode="numeric" maxlength="4" value="{{ row.pct }}" placeholder="e.g. {{ [10, 20, 25][loop.index0] }}">
      </div>
    </div>
    {% endfor %}
  </fieldset>

  <fieldset>
    <legend>Privacy</legend>
    <div class="field{% if errors.retention_days %} has-error{% endif %}">
      <label for="f-retention_days">Keep customer details for</label>
      <div class="promo-row days-row">
        <input id="f-retention_days" name="retention_days" type="text" inputmode="numeric" maxlength="5" value="{{ values.retention_days }}" aria-describedby="h-retention_days">
        <span class="muted-inline">days</span>
      </div>
      {% if errors.retention_days %}<p class="field-error" id="h-retention_days">{{ errors.retention_days }}</p>
      {% else %}<p class="hint" id="h-retention_days">After this many days, finished orders lose their name, email and address. Your sales totals are kept. Orders still being paid for or delivered are never touched.</p>{% endif %}
    </div>
    <div class="field{% if errors.complete_after_days %} has-error{% endif %}">
      <label for="f-complete_after_days">Count shipped orders as delivered after</label>
      <div class="promo-row days-row">
        <input id="f-complete_after_days" name="complete_after_days" type="text" inputmode="numeric" maxlength="4" value="{{ values.complete_after_days }}" aria-describedby="h-complete_after_days">
        <span class="muted-inline">days</span>
      </div>
      {% if errors.complete_after_days %}<p class="field-error" id="h-complete_after_days">{{ errors.complete_after_days }}</p>
      {% else %}<p class="hint" id="h-complete_after_days">A shipped order becomes complete this many days after you mark it shipped, or straight away if you press "Mark as delivered". The deletion period above starts from then.</p>{% endif %}
    </div>
    <label class="check"><input type="checkbox" name="purge_enabled"{% if values.purge_enabled %} checked{% endif %}>
      Delete automatically every night</label>
    <label class="check"><input type="checkbox" name="export_before_purge"{% if values.export_before_purge %} checked{% endif %}>
      Only delete orders that have been exported <span class="muted-inline">(applies once your export key is set; see Export)</span></label>
  </fieldset>

  <button type="submit">Save settings</button>
</form>

<section class="card-flat narrow spaced">
  <h2>Deletion history</h2>
  {% if lastRun %}
    <p>Last run {{ lastRun.when }} ({{ lastRun.by }}): {{ lastRun.orders }} order{% if lastRun.orders != 1 %}s{% endif %} and
      {{ lastRun.customers }} account{% if lastRun.customers != 1 %}s{% endif %} cleared.{% if lastRun.error %} <span class="warn-text">Error: {{ lastRun.error }}</span>{% endif %}</p>
  {% else %}
    <p class="muted">No deletion has run yet.</p>
  {% endif %}
  <form method="post" action="/admin/settings/purge">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <button type="submit" class="secondary small">Run the deletion now</button>
  </form>
  <p class="hint">Uses the retention period above. Nothing newer than that is touched.</p>
</section>

{% endblock %}
